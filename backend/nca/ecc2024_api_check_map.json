        "oci_lb_tls_policy_secure",
        "oci_api_gateway_https_only"
      ],
      "coverage": "full"
    },
    "Check SPF record exists for corporate mail domains": {
      "checks": [
        "oci_dns_mail_domain_spf_dmarc"
      ],
      "coverage": "full",
      "note": "Domains hosted in OCI DNS that publish an MX record."
    },
    "Check DMARC policy for corporate mail domains": {
      "checks": [
        "oci_dns_mail_domain_spf_dmarc"
      ],
      "coverage": "full",
      "note": "Domains hosted in OCI DNS that publish an MX record."
    },
    "Check database encryption at rest": {
      "checks": [
        "oci_database_encryption_at_rest"
      ],
      "coverage": "full"
    },
    "Detect critical databases without point-in-time recovery where required": {
      "checks": [
