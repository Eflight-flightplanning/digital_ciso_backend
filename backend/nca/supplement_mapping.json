{
  "_description": "Platform-authored additions to the vendored Prowler NCA framework files. Prowler's own Checks arrays are used unchanged (source=framework); entries here add further OCI checks that are technically relevant to a control (source=platform-supplement). Every control remains scope=partial: automated checks can only evidence the technical portion of an NCA control, so an all-PASS automated result yields MANUAL (PARTIAL_AUTOMATION) until a reviewer approves evidence for the rest. No requirement text is invented here; only check-to-control relevance.",
  "common": {
    "2-2-3": {
      "checks": [
        "identity_password_policy_prevents_reuse",
        "identity_password_policy_expires_within_365_days",
        "identity_user_auth_tokens_rotated_90_days",
        "identity_user_customer_secret_keys_rotated_90_days",
        "identity_tenancy_admin_users_no_api_keys",
        "identity_iam_admins_cannot_update_tenancy_admins",
        "identity_storage_service_level_admins_scoped"
      ],
      "rationale": "Authentication strength, credential rotation and least-privilege administration."
    },
    "2-3-3": {
      "checks": [
        "compute_instance_secure_boot_enabled"
      ],
      "rationale": "Information-system hardening of compute instances."
    },
    "2-5-3": {
      "checks": [
        "database_autonomous_database_access_restricted",
        "analytics_instance_access_restricted",
        "integration_instance_access_restricted"
      ],
      "rationale": "Network exposure / access restriction of managed services."
    },
    "2-8-3": {
      "checks": [
        "blockstorage_block_volume_encrypted_with_cmk",
